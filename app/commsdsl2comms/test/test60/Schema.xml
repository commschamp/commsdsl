<?xml version="1.0" encoding="UTF-8"?>
<schema name="test60" endian="big">
    <description>
        Testing simple sync suffix
    </description>
    <fields>
        <enum name="MsgId" type="uint8" semanticType="messageId" >
            <validValue name="M1" val="0" />
            <validValue name="M2" val="1" />
        </enum>
    </fields>

    <message name="Msg1" id="MsgId.M1">
        <int type="uint16" name="F1" />
    </message>

    <message name="Msg2" id="MsgId.M2">
        <int type="uint32" name="F1" />
    </message>

    <frame name="Frame">
        <sync name="Prefix">
            <int name="PrefixField" type="uint8" defaultValue="0x02" />
        </sync>
        <size name="Size">
            <int name="SizeField" type="uint16" />
        </size>
        <id name="Id" field="MsgId" />
        <payload name="Data" />
        <sync name="Suffix">
            <int name="SuffixField" type="uint8" defaultValue="0x03"/>
        </sync>
    </frame>
</schema>
