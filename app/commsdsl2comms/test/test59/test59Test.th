#include "cxxtest/TestSuite.h"

#include "test59/Message.h"
#include "test59/frame/Frame.h"

#include "comms/process.h"

#include <cstdint>
#include <type_traits>

class TestSuite : public CxxTest::TestSuite
{
public:
    void test1();

    // struct Handler
    // {
    //     template <typename TMsg>
    //     void handle(TMsg& msg)
    //     {
    //         static_cast<void>(msg);
    //     }
    // };

    using Interface = test59::Message<
        comms::option::app::IdInfoInterface,
        comms::option::app::LengthInfoInterface,
        comms::option::app::ReadIterator<const std::uint8_t*>,
        comms::option::app::WriteIterator<std::uint8_t*>,
        comms::option::app::NameInterface
    >;
    using Frame = test59::frame::Frame<Interface>;

    TEST59_ALIASES_FOR_ALL_MESSAGES_DEFAULT_OPTIONS(,,Interface);
};

void TestSuite::test1()
{
    const std::uint8_t Buf[] = {
        0xab, 0xcd, // Prefix
        0x00, 0x05, // Size
        static_cast<std::uint8_t>(test59::MsgId_M1),
        0x01, 0x02, 0x03,
        0x06, // Checksum
    };
    const std::size_t BufSize = std::extent<decltype(Buf)>::value;

    Frame frame;
    Frame::MsgPtr msgPtr;

    auto iter = comms::readIteratorFor<Interface>(Buf);
    auto es = frame.read(msgPtr, iter, BufSize);
    TS_ASSERT_EQUALS(es, comms::ErrorStatus::Success);
    TS_ASSERT(msgPtr);
    TS_ASSERT_EQUALS(msgPtr->getId(), test59::MsgId_M1);

    std::vector<std::uint8_t> outputBuf;
    outputBuf.resize(frame.length(*msgPtr));

    auto writeIter = comms::writeIteratorFor<Interface>(outputBuf.data());
    es = frame.write(*msgPtr, writeIter, outputBuf.size());
    TS_ASSERT_EQUALS(es, comms::ErrorStatus::Success);
    TS_ASSERT_EQUALS(outputBuf.size(), BufSize);
    TS_ASSERT(std::equal(outputBuf.begin(), outputBuf.end(), Buf));
}

