<?xml version="1.0" encoding="UTF-8"?>
<schema name="test61" endian="big">
    <description>
        Testing masks in optional conditions.
    </description>
    <fields>
        <enum name="MsgId" type="uint8" semanticType="messageId" >
            <validValue name="M1" val="0" />
            <validValue name="M2" val="1" />
        </enum>

        <set name="S1" length="1">
            <bit name="B0" idx="0" />
            <bit name="B1" idx="1" />
            <mask name="M0" bits="B0 | B1" />
        </set>
    </fields>

    <interface name="Interface">
        <ref name="Flags" field="S1" />
    </interface>

    <message name="Msg1" id="MsgId.M1">
        <int type="uint16" name="F1" />
        <optional name="F2" cond="%Flags.M0">
            <int type="uint16" name="ActF2" />
        </optional>
    </message>

    <message name="Msg2" id="MsgId.M2" construct="%Flags.M0">
        <fields>
            <int type="uint16" name="F1" />
        </fields>
        <constructAsReadCond value="true" />
        <constructAsValidCond value="true" />
    </message>

    <frame name="Frame">
        <id name="Id" field="MsgId" />
        <value name="Flags" field="S1" interfaceFieldName="Flags" />
        <payload name="Data" />
    </frame>
</schema>
