
function test41_local.message_Msg1_read(tvb, tree, offset, offset_limit)
    local result, next_offset = test41_local.message_Msg1_readOrig(tvb, tree, offset, offset_limit)
    if result == test41_local.StatusCode.SUCCESS then
        test41_local.prot_version_set(test41_local.field_Version_value())
    end

    return result, next_offset
end
